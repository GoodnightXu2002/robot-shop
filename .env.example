# Flask application settings
SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=development

# Database
# Recommended default: <project root>/robot_shop.db.
# config.py resolves relative SQLite paths from the project root.
# You can replace this with another absolute SQLite path or SQLAlchemy database URI.
DATABASE_URL=sqlite:///robot_shop.db

# Optional AI assistant integration
# Leave empty to use the local rule-based assistant only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
